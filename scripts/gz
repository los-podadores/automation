#!/usr/bin/env bash
# Agnostic Gazebo CLI entrypoint.
# Forwards CLI commands to Gazebo Harmonic inside the container with sanitized environment.
set -e

export PATH="/run/current-system/sw/bin:$PATH"
export DBX_CONTAINER_MANAGER="docker"
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONTAINER_NAME="gazebo-harmonic"

# Ensure container is started if container runtime is present
if command -v docker >/dev/null 2>&1; then
    STATUS="$(docker inspect --type container --format '{{.State.Status}}' "$CONTAINER_NAME" 2>/dev/null || true)"
    if [ "$STATUS" != "running" ]; then
        docker start "$CONTAINER_NAME" >/dev/null 2>&1 || true
    fi
fi

RES_PATH="${GZ_SIM_RESOURCE_PATH:-$DIR/src/v2/model}"

# Execute /usr/bin/gz inside distrobox container with X11/XWayland GLX compatibility
exec distrobox enter "$CONTAINER_NAME" -- bash -c '
    for var in $(compgen -v | grep -E "^(NIX_|CMAKE_|LD_|PYTHON)"); do
        unset "$var"
    done
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export DISPLAY="'"${DISPLAY:-:0}"'"
    export WAYLAND_DISPLAY="'"${WAYLAND_DISPLAY:-}"'"
    export XDG_RUNTIME_DIR="'"${XDG_RUNTIME_DIR:-}"'"
    export QT_QPA_PLATFORM=xcb
    export GZ_IP=127.0.0.1
    export GZ_PARTITION="${GZ_PARTITION:-los_podadores}"
    export GZ_SIM_RESOURCE_PATH="'"$RES_PATH"'"
    export SDF_PATH="'"$RES_PATH"'"
    export GZ_SIM_SYSTEM_PLUGIN_PATH="'"$DIR"'/src/sim/gzdrl/_lib:${GZ_SIM_SYSTEM_PLUGIN_PATH:-}"
    exec /usr/bin/gz "$@"
' -- "$@"
