    <plugin name="gz::sim::systems::AckermannSteering" filename="gz-sim-ackermann-steering-system">
      <steering_only>true</steering_only>
      <left_steering_joint>front_left_steering</left_steering_joint>
      <right_steering_joint>front_right_steering</right_steering_joint>
      <wheel_base>2.0</wheel_base>
      <wheel_separation>1.13</wheel_separation>
      <steering_limit>0.4</steering_limit>
      <steer_p_gain>4.0</steer_p_gain>
      <topic>/model/tractor/steering_angle</topic>
    </plugin>
    <plugin name="gz::sim::systems::DiffDrive" filename="gz-sim-diff-drive-system">
      <left_joint>rear_left_spin</left_joint>
      <right_joint>rear_right_spin</right_joint>
      <wheel_separation>1.4</wheel_separation>
      <wheel_radius>0.5</wheel_radius>
      <topic>/model/tractor/rear_axle/cmd_vel</topic>
      <odom_topic>/model/tractor/wheel_odometry</odom_topic>
      <tf_topic>/model/tractor/wheel_odometry_tf</tf_topic>
      <frame_id>tractor/odom</frame_id>
      <child_frame_id>tractor/rear_axle</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <plugin name="gz::sim::systems::JointStatePublisher" filename="gz-sim-joint-state-publisher-system">
