    <!-- Dynamic Obstacle 3: dynamic_ped_1 -->
    <model name="obstacle_3">
      <pose>37.100 -20.000 0.875 0 0 0.0000</pose>
      <link name="link">
        <gravity>false</gravity>
        <inertial>
          <mass>50.0</mass>
          <inertia>
            <ixx>1.0</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1.0</iyy><iyz>0</iyz>
            <izz>1.0</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.400</radius><length>1.750</length></cylinder></geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.01</mu>
                <mu2>0.01</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.400</radius><length>1.750</length></cylinder></geometry>
          <material><ambient>0.90 0.45 0.25 1.0</ambient><diffuse>0.95 0.50 0.30 1.0</diffuse></material>
        </visual>
      </link>
      <plugin
        filename="gz-sim-trajectory-follower-system"
        name="gz::sim::systems::TrajectoryFollower">
        <link_name>link</link_name>
        <loop>true</loop>
        <force>120</force>
        <torque>20</torque>
        <range_tolerance>0.3</range_tolerance>
        <waypoints>
          <waypoint>37.100 -20.000</waypoint>
          <waypoint>42.900 -20.000</waypoint>
        </waypoints>
      </plugin>
      <plugin
        filename="gz-sim-odometry-publisher-system"
        name="gz::sim::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>obstacle_3/link</robot_base_frame>
        <odom_topic>/model/obstacle_3/odometry</odom_topic>
        <odom_publish_frequency>20</odom_publish_frequency>
        <dimensions>2</dimensions>
      </plugin>
    </model>

    <!-- Include Large-Scale Ackermann Tractor -->
    <include>
      <uri>model://tractor</uri>
      <pose>0.000 0.000 0.00 0 0 0.0000</pose>
    </include>
  </world>
</sdf>
