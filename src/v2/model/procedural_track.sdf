        </visual>
      </link>
    </model>
    <!-- Dynamic Obstacle 5: plaza_crossing_pedestrian -->
    <model name="obstacle_5">
      <pose>94.000 38.000 0.900 0 0 0.0000</pose>
      <link name="slider">
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.01</iyy><iyz>0</iyz>
            <izz>0.01</izz>
          </inertia>
        </inertial>
      </link>
      <joint name="guide" type="prismatic">
        <parent>world</parent>
        <child>slider</child>
        <axis>
          <xyz>1.0000 -0.0000 0</xyz>
          <limit>
            <lower>-0.2</lower>
            <upper>26.200</upper>
          </limit>
          <dynamics>
            <damping>35.0</damping>
            <friction>5.0</friction>
          </dynamics>
        </axis>
      </joint>
      <link name="link">
        <inertial>
          <mass>20.0</mass>
          <inertia>
            <ixx>1.0</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1.0</iyy><iyz>0</iyz>
            <izz>0.5</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.400</radius><length>1.800</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.400</radius><length>1.800</length></cylinder></geometry>
          <material><ambient>0.90 0.45 0.25 1.0</ambient><diffuse>0.95 0.50 0.30 1.0</diffuse></material>
        </visual>
      </link>
      <joint name="pivot" type="revolute">
        <parent>slider</parent>
        <child>link</child>
        <axis>
          <xyz>0 0 1</xyz>
          <dynamics>
            <damping>3.0</damping>
          </dynamics>
        </axis>
      </joint>
      <plugin
        filename="gz-sim-trajectory-follower-system"
        name="gz::sim::systems::TrajectoryFollower">
        <link_name>link</link_name>
        <loop>true</loop>
        <force>45</force>
        <torque>25</torque>
        <range_tolerance>0.3</range_tolerance>
        <waypoints>
          <waypoint>94.000 38.000</waypoint>
          <waypoint>120.000 38.000</waypoint>
        </waypoints>
      </plugin>
      <plugin
        filename="gz-sim-odometry-publisher-system"
        name="gz::sim::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>obstacle_5/link</robot_base_frame>
        <odom_topic>/model/obstacle_5/odometry</odom_topic>
        <odom_publish_frequency>20</odom_publish_frequency>
        <dimensions>2</dimensions>
      </plugin>
    </model>

    <!-- Include Large-Scale Ackermann Tractor -->
    <include>
      <uri>model://tractor</uri>
      <pose>0.000 0.000 0.00 0 0 0.0000</pose>
    </include>
  </world>
</sdf>
