<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="procedural_car_track">
    <physics type="dart">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>0</real_time_factor>
      <real_time_update_rate>5000000</real_time_update_rate>
      <dart>
        <solver><solver_type>dantzig</solver_type></solver>
        <collision_detector>bullet</collision_detector>
      </dart>
    </physics>

    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system">
      <engine>
        <filename>gz-physics-dartsim-plugin</filename>
      </engine>
    </plugin>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <!-- Handled by gzdrl in-process Sensors plugin -->
    <!-- <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin> -->

    <!-- Sun / Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 35 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- High-Traction Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>0 0 -0.5 0 0 0</pose>
          <geometry>
            <box>
              <size>600 600 1.0</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100.0</mu>
                <mu2>100.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>600 600</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.22 0.25 0.22 1.0</ambient>
            <diffuse>0.32 0.38 0.30 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Point A Beacon (Start) -->
    <model name="beacon_point_a">
      <static>true</static>
      <pose>0.000 0.000 1.8 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <sphere><radius>0.50</radius></sphere>
          </geometry>
          <material>
            <ambient>0.1 0.85 0.2 1.0</ambient>
            <diffuse>0.1 0.95 0.2 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Point B Beacon (Goal) -->
    <model name="beacon_point_b">
      <static>true</static>
      <pose>108.000 60.000 1.8 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <sphere><radius>0.50</radius></sphere>
          </geometry>
          <material>
            <ambient>0.2 0.45 0.95 1.0</ambient>
            <diffuse>0.2 0.55 1.0 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>

