<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="tractor">
    <pose>0 0 0.40 0 0 0</pose>
    <static>false</static>

    <!-- Base / Chassis Link -->
    <link name="chassis">
      <pose>0 0 0.20 0 0 0</pose>
      <inertial>
        <mass>950.0</mass>
        <inertia>
          <ixx>180.0</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>850.0</iyy>
          <iyz>0.0</iyz>
          <izz>920.0</izz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <pose>0 0 0.20 0 0 0</pose>
        <geometry>
          <box>
            <size>3.80 1.90 1.40</size>
          </box>
        </geometry>
      </collision>
      <visual name="chassis_visual">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://chasis.obj</uri>
            <scale>0.0035 0.0035 0.0035</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.5 0.2 1.0</ambient>
          <diffuse>0.2 0.6 0.2 1.0</diffuse>
        </material>
      </visual>

      <!-- Pod 0: Front-Center LiDAR (0 deg, 15m range) -->
      <sensor name="lidar_front" type="gpu_lidar">
        <pose>1.90 0 0.65 0 0 0</pose>
        <update_rate>20</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>180</samples>
              <resolution>1</resolution>
              <min_angle>-1.047198</min_angle>
              <max_angle>1.047198</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.15</min>
            <max>15.0</max>
            <resolution>0.02</resolution>
          </range>
        </ray>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <topic>/tractor/lidar/front</topic>
      </sensor>

      <!-- Pod 1: Rear-Center LiDAR (180 deg, 15m range) -->
      <sensor name="lidar_rear" type="gpu_lidar">
        <pose>-1.90 0 0.65 0 0 3.14159265</pose>
        <update_rate>20</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>180</samples>
              <resolution>1</resolution>
              <min_angle>-1.047198</min_angle>
              <max_angle>1.047198</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.15</min>
            <max>15.0</max>
            <resolution>0.02</resolution>
          </range>
        </ray>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <topic>/tractor/lidar/rear</topic>
      </sensor>

      <!-- Pod 2: Front-Right Retrovisor LiDAR (-90 deg, 15m range) -->
      <sensor name="lidar_right" type="gpu_lidar">
        <pose>1.00 -0.95 0.70 0 0 -1.5707963</pose>
        <update_rate>20</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>150</samples>
              <resolution>1</resolution>
              <min_angle>-0.872665</min_angle>
              <max_angle>0.872665</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.15</min>
            <max>15.0</max>
            <resolution>0.02</resolution>
          </range>
        </ray>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <topic>/tractor/lidar/right</topic>
      </sensor>

      <!-- Pod 3: Front-Left Retrovisor LiDAR (+90 deg, 15m range) -->
      <sensor name="lidar_left" type="gpu_lidar">
        <pose>1.00 0.95 0.70 0 0 1.5707963</pose>
        <update_rate>20</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>150</samples>
              <resolution>1</resolution>
              <min_angle>-0.872665</min_angle>
              <max_angle>0.872665</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.15</min>
            <max>15.0</max>
            <resolution>0.02</resolution>
          </range>
        </ray>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <topic>/tractor/lidar/left</topic>
      </sensor>
    </link>

    <!-- ================= Front Left Steering Knuckle ================= -->
    <link name="front_left_steer">
      <pose>1.25 0.80 0 0 0 0</pose>
      <inertial>
        <mass>12.0</mass>
        <inertia>
          <ixx>0.08</ixx>
          <iyy>0.08</iyy>
          <izz>0.08</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="front_left_steer_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_left_steer</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.5585</lower>
          <upper>0.5585</upper>
          <effort>500.0</effort>
          <velocity>2.5</velocity>
        </limit>
      </axis>
    </joint>

    <!-- ================= Front Left Wheel ================= -->
    <link name="front_left_wheel">
      <pose>1.25 0.80 0 0 0 0</pose>
      <inertial>
        <mass>22.0</mass>
        <inertia>
          <ixx>0.85</ixx>
          <iyy>1.45</iyy>
          <izz>0.85</izz>
        </inertia>
      </inertial>
      <collision name="fl_collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.38</radius>
            <length>0.22</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="fl_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://front.obj</uri>
            <scale>0.0035 0.0035 0.0035</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.1 0.1 0.1 1.0</diffuse>
        </material>
      </visual>
    </link>
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_steer</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <!-- ================= Front Right Steering Knuckle ================= -->
    <link name="front_right_steer">
      <pose>1.25 -0.80 0 0 0 0</pose>
      <inertial>
        <mass>12.0</mass>
        <inertia>
          <ixx>0.08</ixx>
          <iyy>0.08</iyy>
          <izz>0.08</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="front_right_steer_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_right_steer</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.5585</lower>
          <upper>0.5585</upper>
          <effort>500.0</effort>
          <velocity>2.5</velocity>
        </limit>
      </axis>
    </joint>

    <!-- ================= Front Right Wheel ================= -->
    <link name="front_right_wheel">
      <pose>1.25 -0.80 0 0 0 0</pose>
      <inertial>
        <mass>22.0</mass>
        <inertia>
          <ixx>0.85</ixx>
          <iyy>1.45</iyy>
          <izz>0.85</izz>
        </inertia>
      </inertial>
      <collision name="fr_collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.38</radius>
            <length>0.22</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="fr_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://front.obj</uri>
            <scale>0.0035 0.0035 0.0035</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.1 0.1 0.1 1.0</diffuse>
        </material>
      </visual>
    </link>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_steer</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <!-- ================= Rear Left Drive Wheel ================= -->
    <link name="rear_left_wheel">
      <pose>-1.25 0.80 0 0 0 0</pose>
      <inertial>
        <mass>30.0</mass>
        <inertia>
          <ixx>1.2</ixx>
          <iyy>2.1</iyy>
          <izz>1.2</izz>
        </inertia>
      </inertial>
      <collision name="rl_collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.38</radius>
            <length>0.22</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.4</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="rl_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://back.obj</uri>
            <scale>0.0035 0.0035 0.0035</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.1 0.1 0.1 1.0</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <!-- ================= Rear Right Drive Wheel ================= -->
    <link name="rear_right_wheel">
      <pose>-1.25 -0.80 0 0 0 0</pose>
      <inertial>
        <mass>30.0</mass>
        <inertia>
          <ixx>1.2</ixx>
          <iyy>2.1</iyy>
          <izz>1.2</izz>
        </inertia>
      </inertial>
      <collision name="rr_collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.38</radius>
            <length>0.22</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.4</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="rr_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://back.obj</uri>
            <scale>0.0035 0.0035 0.0035</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.1 0.1 0.1 1.0</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <!-- ================= Ackermann Steering Plugin ================= -->
    <plugin
      filename="gz-sim-ackermann-steering-system"
      name="gz::sim::systems::AckermannSteering">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steer_joint</left_steering_joint>
      <right_steering_joint>front_right_steer_joint</right_steering_joint>
      <kingpin_width>1.50</kingpin_width>
      <wheelbase>2.50</wheelbase>
      <wheel_separation>1.60</wheel_separation>
      <wheel_radius>0.38</wheel_radius>
      <min_velocity>-1.2</min_velocity>
      <max_velocity>3.0</max_velocity>
      <min_acceleration>-2.5</min_acceleration>
      <max_acceleration>1.5</max_acceleration>
      <topic>/cmd_vel</topic>
    </plugin>
  </model>
</sdf>
