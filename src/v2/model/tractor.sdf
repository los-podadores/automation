<?xml version="1.0" ?>
<sdf version="1.10">
  <model name="tractor" canonical_link="chassis">
    <self_collide>false</self_collide>
    <link name="chassis">
      <sensor name="lidar_front" type="gpu_lidar">
        <pose>2.175 0 0.9 0 0.349066 0</pose>
        <topic>/tractor/lidar/front</topic>
        <update_rate>20</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>180</samples>
              <resolution>1</resolution>
              <min_angle>-1.047198</min_angle>
              <max_angle>1.047198</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.436332</min_angle>
              <max_angle>0.261799</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.15</min>
            <max>25.0</max>
            <resolution>0.02</resolution>
          </range>
        </ray>
      </sensor>
      <sensor name="lidar_rear" type="gpu_lidar">
        <pose>-2.175 0 0.9 0 0.349066 3.141592654</pose>
        <topic>/tractor/lidar/rear</topic>
        <update_rate>20</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>180</samples>
              <resolution>1</resolution>
              <min_angle>-1.047198</min_angle>
              <max_angle>1.047198</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.436332</min_angle>
              <max_angle>0.261799</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.15</min>
            <max>25.0</max>
            <resolution>0.02</resolution>
          </range>
        </ray>
      </sensor>
      <inertial>
        <pose>0 0 0.75 0 0 0</pose>
        <mass>300.0</mass>
        <inertia>
          <ixx>73.38812499999999</ixx>
          <iyy>278.785</iyy>
          <izz>349.048125</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="connecting_beam_visual">
