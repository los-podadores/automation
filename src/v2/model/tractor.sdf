<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="tractor">
    <pose>0 0 0.25 0 0 0</pose>
    <static>false</static>

    <!-- Base / Chassis Link -->
    <link name="chassis">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>120.0</mass>
        <inertia>
          <ixx>4.2</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>12.8</iyy>
          <iyz>0.0</iyz>
          <izz>14.5</izz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <box>
            <size>1.08 0.56 0.25</size>
          </box>
        </geometry>
      </collision>
      <visual name="chassis_visual">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://chasis.obj</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.5 0.2 1.0</ambient>
          <diffuse>0.2 0.6 0.2 1.0</diffuse>
        </material>
      </visual>
    </link>

    <!-- ================= Front Left Steering Knuckle ================= -->
    <link name="front_left_steer">
      <pose>0.40 0.30 -0.065 0 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="front_left_steer_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_left_steer</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.523599</lower>
          <upper>0.523599</upper>
          <effort>100.0</effort>
          <velocity>2.0</velocity>
        </limit>
      </axis>
    </joint>

    <!-- ================= Front Left Wheel ================= -->
    <link name="front_left_wheel">
      <pose>0.40 0.32 -0.065 0 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.08</ixx>
          <iyy>0.14</iyy>
          <izz>0.08</izz>
        </inertia>
      </inertial>
      <collision name="fl_collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.185</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="fl_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://front.obj</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.1 0.1 0.1 1.0</diffuse>
        </material>
      </visual>
    </link>
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_steer</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <!-- ================= Front Right Steering Knuckle ================= -->
    <link name="front_right_steer">
      <pose>0.40 -0.30 -0.065 0 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="front_right_steer_joint" type="revolute">
      <parent>chassis</parent>
      <child>front_right_steer</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.523599</lower>
          <upper>0.523599</upper>
          <effort>100.0</effort>
          <velocity>2.0</velocity>
        </limit>
      </axis>
    </joint>

    <!-- ================= Front Right Wheel ================= -->
    <link name="front_right_wheel">
      <pose>0.40 -0.32 -0.065 0 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.08</ixx>
          <iyy>0.14</iyy>
          <izz>0.08</izz>
        </inertia>
      </inertial>
      <collision name="fr_collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.185</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="fr_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://front.obj</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.1 0.1 0.1 1.0</diffuse>
        </material>
      </visual>
    </link>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_steer</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <!-- ================= Rear Left Drive Wheel ================= -->
    <link name="rear_left_wheel">
      <pose>-0.40 0.32 0 0 0 0</pose>
      <inertial>
        <mass>14.0</mass>
        <inertia>
          <ixx>0.24</ixx>
          <iyy>0.44</iyy>
          <izz>0.24</izz>
        </inertia>
      </inertial>
      <collision name="rl_collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>0.135</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.4</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="rl_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://back.obj</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.1 0.1 0.1 1.0</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <!-- ================= Rear Right Drive Wheel ================= -->
    <link name="rear_right_wheel">
      <pose>-0.40 -0.32 0 0 0 0</pose>
      <inertial>
        <mass>14.0</mass>
        <inertia>
          <ixx>0.24</ixx>
          <iyy>0.44</iyy>
          <izz>0.24</izz>
        </inertia>
      </inertial>
      <collision name="rr_collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>0.135</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.4</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="rr_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://back.obj</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.1 0.1 0.1 1.0</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>chassis</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
      </axis>
    </joint>

    <!-- ================= Ackermann Steering Plugin ================= -->
    <plugin
      filename="gz-sim-ackermann-steering-system"
      name="gz::sim::systems::AckermannSteering">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steer_joint</left_steering_joint>
      <right_steering_joint>front_right_steer_joint</right_steering_joint>
      <kingpin_width>0.60</kingpin_width>
      <wheelbase>0.80</wheelbase>
      <wheel_separation>0.64</wheel_separation>
      <wheel_radius>0.25</wheel_radius>
      <min_velocity>-3.0</min_velocity>
      <max_velocity>8.0</max_velocity>
      <min_acceleration>-4.0</min_acceleration>
      <max_acceleration>4.0</max_acceleration>
      <topic>/cmd_vel</topic>
    </plugin>
  </model>
</sdf>
